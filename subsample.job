#!/bin/bash

#############################################################################################
# This reduces the file sizes of the demultiplexed reads
# I found Admera's file sizes to be enormous
# Dean's average file size per read was about 30 MB, while Admera was about 700 MB to 1 GB!
# Here, I'm reducing the Admera files by 90% (i.e. keep only 10% of fragments)
#############################################################################################

############################################################################################
# Submit this script as a job using:

# qsub INPUT_DIR="/mnt/lustre/users/cvansteenderen/RADseq_crystallinum/data/Admera/stacksoutput/combined_plates/ready",SAMPLERATE=0.1 1_subsample.job

############################################################################################

#PBS -l select=1:ncpus=10
#PBS -P CBBI1682
#PBS -q serial
#PBS -l walltime=4:00:00
#PBS -N subsampling
#PBS -M vsteenderen@gmail.com
#PBS -m abe

##############################################################

module add chpc/BIOMODULES
module add bbmap

# Set input/output directories
INPUT_DIR="$INPUT_DIR"
OUTPUT_DIR="$INPUT_DIR/subsampled"

cd INPUT_DIR

# Make sure output directory exists
mkdir -p "$OUTPUT_DIR"

# Set fraction of read pairs to keep
SAMPLERATE=$SAMPLERATE

echo "Subsampling $SAMPLERATE of reads per sample file..."

# Loop over all *.1.fq.gz files
for R1 in "$INPUT_DIR"/*.1.fq.gz; do
    BASENAME=$(basename "$R1" .1.fq.gz)
    R2="$INPUT_DIR/${BASENAME}.2.fq.gz"

    # Check if R2 exists
    if [[ -f "$R2" ]]; then
        echo "Subsampling $BASENAME..."

        reformat.sh \
            in1="$R1" in2="$R2" \
            out1="$OUTPUT_DIR/${BASENAME}.1.fq.gz" \
            out2="$OUTPUT_DIR/${BASENAME}.2.fq.gz" \
            samplerate="$SAMPLERATE" \
            ziplevel=6
    else
        echo "❌ Missing R2 for $BASENAME, skipping."
    fi
done

echo "✅ Subsampling complete. Output saved to: $OUTPUT_DIR"
