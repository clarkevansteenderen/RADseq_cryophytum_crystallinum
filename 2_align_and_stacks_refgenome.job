#!/bin/bash

############################################################################################
# ALIGN FRAGMENTS TO REF GENOME, PROCESS, AND RUN Stacks

# Make sure that there is a barcodes/ folder in your HOME_DIR, that contains all sample names 
# and pop assignments. This should automatically be there if you have only been working with
# one project. But, if this is combined from different projects, then manually combine the 
# bothplates_pops.txt files from each project into one big one

############################################################################################
# Submit this script as a job using:

# qsub -v SAMPLE_DIR="/mnt/lustre/users/cvansteenderen/RADseq_crystallinum/data/combined_data_all_spp/ready",BARCODES_DIR="/mnt/lustre/users/cvansteenderen/RADseq_crystallinum/data/combined_data_all_spp/barcodes",REFERENCE_INDEX="/mnt/lustre/users/cvansteenderen/RADseq_crystallinum/data/ref_genome/ncbi_dataset/data/GCA_030267885.1/reference_index" 2_align_and_stacks_refgenome.job

############################################################################################

#PBS -l select=1:ncpus=12
#PBS -P CBBI1682
#PBS -q serial
#PBS -l walltime=52:00:00
#PBS -o /mnt/lustre/users/cvansteenderen/RADseq_crystallinum/data/combined_data_all_spp/refgen_align_stdout.txt
#PBS -e /mnt/lustre/users/cvansteenderen/RADseq_crystallinum/data/combined_data_all_spp/refgen_align_stderr.txt
#PBS -N stacks_refgenome
#PBS -M vsteenderen@gmail.com
#PBS -m abe

##############################################################

module add chpc/BIOMODULES
module add bowtie2
module add samtools
module add stacks

cd "$SAMPLE_DIR"

##############################################################
# align fragments to the reference genome
##############################################################

# specifying paths to -1 and -2 means we're dealing with paired end reads

mkdir -p "$SAMPLE_DIR/refgenome_alignments"
ALIGNED_DIR="$SAMPLE_DIR/refgenome_alignments"

##############################################################
# Loop through all forward read files in the /combined_plates/ready directory
##############################################################

echo "Aligning to reference genome..."

# for forward in *.1.fq.gz; do reverse="${forward/.1.fq.gz/.2.fq.gz}"; sample_name=$(basename "$forward" | sed -E 's/(.*)\.[12]\.fq\.gz/\1/'); output_bam="${ALIGNED_DIR}/${sample_name}.bam"; bowtie2 -x "$REFERENCE_INDEX" -1 "$forward" -2 "$reverse" | samtools view -bS -o "$output_bam" -; done
for forward in *.1.fq.gz; do
    # Define the reverse read file based on the forward read file name
    reverse="${forward/.1.fq.gz/.2.fq.gz}"

    # Extract the sample name (everything before the last .1 or .2)
    sample_name=$(basename "$forward" | sed -E 's/(.*)\.[12]\.fq\.gz/\1/')

    # Define output BAM file name
    output_bam="${ALIGNED_DIR}/${sample_name}.bam"

    # Run Bowtie2 alignment and pipe the output to Samtools to convert to a BAM file format (more space efficient)
    bowtie2 -x "$REFERENCE_INDEX" -1 "$forward" -2 "$reverse" | \
    samtools view -bS -o "$output_bam" -
done

cd "$ALIGNED_DIR"

# get a list of all the sample names (i.e. bam files)
find -type f -name '*.bam' | xargs -n 1 basename | sed 's/\.bam$//' | sort -u > samplenames.txt

############################################################################################################################
# SAMTOOLS: SORT THE REF GENOME ALIGNMENTS
############################################################################################################################

echo "Sorting alignment..."

# Directory containing your unsorted BAM files
input_dir="$ALIGNED_DIR"

# Directory where you want to save the sorted BAM files
# these sorted BAM files will serve as the input for Stacks ref_map.pl function for assembling reads based on a ref genome
ALIGNED_SORTED_DIR="$SAMPLE_DIR/refgenome_alignments_sorted"

# Create the output directory if it doesn't exist
mkdir -p "$ALIGNED_SORTED_DIR"

# Loop through each BAM file in the input directory

for bam_file in "$input_dir"/*.bam; do

    # Extract the base name of the BAM file (without the directory and extension)
    base_name=$(basename "$bam_file" .bam)

    # Define the output sorted BAM file path
    sorted_bam="$ALIGNED_SORTED_DIR/${base_name}.bam"

    # Sort the BAM file
    samtools sort "$bam_file" -o "$sorted_bam"

    # Get output stats for the sorted BAM file
    samtools flagstat "$sorted_bam" > "${sorted_bam%.bam}_flagstat.txt"

    # Print a message indicating the process is complete for this file
    echo "Processed $bam_file: sorted and stats generated."
	
done

# create a folder that contains the BAM files only

echo "Creating a folder for BAM files..."

cd "$ALIGNED_SORTED_DIR"

mkdir -p bam_files

mv *.bam ./bam_files

echo "Updating sample list in barcodes/..."

cd "$ALIGNED_SORTED_DIR/bam_files"
# create a list of sample names from the sorted bam files
find -type f -name '*.bam' | xargs -n 1 basename | sed 's/\.bam$//' | sort -u > samplenames.txt

# update your barcodes/bothplates_pops.txt file to the sample names present in bam_files
# this is NB, as the sorting process may drop one or more samples, and then your bam files are not exactly the same as the samples listed in your pop file
# Sort input files
sort -k1,1 "$BARCODES_DIR/bothplates_pops.txt" -o "$BARCODES_DIR/bothplates_pops.txt"
sort -k1,1 "$ALIGNED_SORTED_DIR/bam_files/samplenames.txt" -o "$ALIGNED_SORTED_DIR/bam_files/samplenames.txt"

# Create a new filtered output file
join -t $'\t' "$BARCODES_DIR/bothplates_pops.txt" "$ALIGNED_SORTED_DIR/bam_files/samplenames.txt" > "$BARCODES_DIR/bothplates_pops_refgenome.txt"

############################################################################################################################
# STACKS REFERENCE GENOME ref_map.pl -> RUN STACKS ANALYSIS ON ALIGNED FRAGMENTS
############################################################################################################################

echo "Running Stacks ref_map.pl..."

cd "$ALIGNED_SORTED_DIR"

# make the output folder to get ready for running the next step: ref_map.pl
mkdir -p "$ALIGNED_SORTED_DIR/stacksoutput_refgenome"

ref_map.pl -o "$ALIGNED_SORTED_DIR/stacksoutput_refgenome" --popmap "$BARCODES_DIR/bothplates_pops_refgenome.txt" --samples "$ALIGNED_SORTED_DIR/bam_files"

############################################################################################################################
# POPULATIONS
############################################################################################################################

echo "Running populations..."

mkdir -p "$ALIGNED_SORTED_DIR/stacksoutput_refgenome/populations"

# run populations
# this produces the snps.vcf file that you need

populations \
  -P "$ALIGNED_SORTED_DIR/stacksoutput_refgenome/" \
  -O "$ALIGNED_SORTED_DIR/stacksoutput_refgenome/populations" \
  --popmap "$BARCODES_DIR/bothplates_pops_refgenome.txt" \
  -r 0.75 \
  -f p_value \
  -t 12 \
  --hwe \
  #--fstats \
  --phylip-var \
  --plink \
  --phylip \
  --vcf \
  --vcf-all